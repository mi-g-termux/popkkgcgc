{
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/audio/(.*)\\.m4a",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/mp4"
        }
      ]
    },
    {
      "source": "/audio/(.*)\\.mp3",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/mpeg"
        }
      ]
    }
  ]
}
